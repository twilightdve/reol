/**
 * IDから会場情報を取得
 */
export const getVenueById = (venueId: string): Venue | undefined => {
  console.log('getVenueById Debug:', {
    searchingFor: venueId,
    availableIds: VENUES_2026.map(v => v.id),
    totalVenues: VENUES_2026.length
  })
  
  const venue = VENUES_2026.find(venue => venue.id === venueId)
  console.log('Found venue:', venue)
  
  return venue
}

/**
 * 都道府県から会場リストを取得
 */
export const getVenuesByPrefecture = (prefecture: string): Venue[] => {
  return VENUES_2026.filter(venue => venue.location.prefecture === prefecture)
}

/**
 * 日付でソートされた全会場リストを取得
 */
export const getAllVenuesSorted = (): Venue[] => {
  return [...VENUES_2026].sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())
}

/**
 * 次回開催予定の会場を取得
 */
export const getUpcomingVenue = (): Venue | undefined => {
  const now = new Date()
  return VENUES_2026
    .filter(venue => new Date(venue.date) > now)
    .sort((a, b) => new Date(a.date).getTime() - new Date(b.date).getTime())[0]
}

/**
 * 都道府県一覧を取得
 */
export const getPrefectureList = (): string[] => {
  const prefectures = new Set(VENUES_2026.map(venue => venue.location.prefecture))
  return Array.from(prefectures).sort()
}