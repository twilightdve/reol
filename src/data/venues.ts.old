// Reol 美辞学ツアー 2026 会場データ型
export interface VenueLocation {
  prefecture: string
  city: string
  address?: string
  nearestStation?: string
}

export interface VenueTimes {
  open: string
  start: string
}

export interface NearbyAttraction {
  name: string
  description: string
  distance?: string
  website?: string
}

export interface NearbyRestaurant {
  name: string
  cuisine: string
  description: string
  distance?: string
  openTime?: string
  price?: string
  website?: string
  mapsUrl?: string
  recommended?: boolean // おすすめフラグ
  recommendComment?: string // おすすめコメント
}

export interface CoinLocker {
  location: string
  description: string
  price?: string
  distance?: string
  website?: string
  mapsUrl?: string
  recommended?: boolean // おすすめフラグ
  recommendComment?: string // おすすめコメント
}

export interface Cafe {
  name: string
  description: string
  distance?: string
  openTime?: string
  wifi?: boolean
  website?: string
  mapsUrl?: string
  recommended?: boolean // おすすめフラグ
  recommendComment?: string // おすすめコメント
}

export interface ParkingInfo {
  name: string
  description: string
  price?: string
  distance?: string
  website?: string
  address?: string
  mapsUrl?: string
  recommended?: boolean // おすすめフラグ
  recommendComment?: string // おすすめコメント
}

export interface HolyPlace {
  name: string
  description: string
  address?: string
  distance?: string
  type?: string // MV, TV, Event, etc.
  title?: string // 作品タイトル
  needsCost?: boolean
  needsPermission?: boolean
  website?: string
  mapsUrl?: string
}

export interface AccessRoute {
  from: string // 出発地（空港名、新幹線駅名など）
  method: string // 交通手段
  time: string // 所要時間
  description: string // 詳細説明
  cost?: string // 料金目安
  notes?: string // 注意事項
}

export interface LongDistanceAccess {
  fromAirport?: AccessRoute[] // 空港からのアクセス
  fromShinkansen?: AccessRoute[] // 新幹線からのアクセス
  fromExpressBus?: AccessRoute[] // 高速バスからのアクセス
  recommendations?: string // おすすめの来場方法
}

export interface VenueImage {
  url: string // 画像URL
  thumbnail?: string // サムネイル画像URL
  source: 'unsplash' | 'pixabay' | 'find47' | 'other' // 画像ソース
  photographer?: string // 撮影者名
  photographerUrl?: string // 撮影者プロフィールURL
  alt: string // 代替テキスト
  description?: string // 画像の説明
}

export interface Venue {
  id: string
  name: string
  date: string
  times: VenueTimes
  location: VenueLocation
  capacity: number
  access?: string
  mapEmbedUrl?: string
  venueImage?: VenueImage // 会場のメインビジュアル
  coinLockers?: CoinLocker[]
  cafes?: Cafe[]
  parkingOptions?: ParkingInfo[]
  nearbyAttractions?: NearbyAttraction[]
  holyPlaces?: HolyPlace[]
  nearbyRestaurants?: NearbyRestaurant[]
  venueWebsite?: string
  parkingInfo?: string
  longDistanceAccess?: LongDistanceAccess // 遠征組向けアクセス情報
}

